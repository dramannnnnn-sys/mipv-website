# ------------------------------------------------------------------
# MIPV website — environment variables
# Copy to .env.local for local development. On Netlify, add these under
# Project configuration → Environment variables. Never commit real secrets.
# ------------------------------------------------------------------

# Public base URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://mipv.com.my

# --- Enquiry form email delivery (choose ONE provider) --------------
# Where enquiries are delivered. The mailbox must exist and receive mail.
CONTACT_TO_EMAIL=enquiry@mipv.com.my
# Sender address. Must be on a domain verified with your provider.
CONTACT_FROM_EMAIL="MIPV Website <website@mipv.com.my>"

# Option A (recommended): Resend — https://resend.com
RESEND_API_KEY=

# Option B: any SMTP service (e.g. Google Workspace, Microsoft 365, Zoho, cPanel mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Optional spam protection: Cloudflare Turnstile ------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
